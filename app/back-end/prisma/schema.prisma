// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== ENUMS ====

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RoleName {
  ROOT_ADMIN
  ADMIN
  USER
}

enum AccountProvider {
  GOOGLE
  FACEBOOK
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
}

enum PermissionResource {
  USER
  PROFILE
  ROLE
  CATEGORY
  CRAWL_CONFIG
  GENERAL_PRODUCT
  STORE
  PRODUCT
}

// ===== MODELS =====

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String?  @map("first_name") @db.VarChar(50)
  lastName  String?  @map("last_name") @db.VarChar(50)
  userName  String?  @map("user_name") @db.VarChar(50)
  email     String   @unique @db.VarChar(255)
  password  String?  @db.VarChar(255)
  avtUrl    String?  @map("avt_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  profile       Profile?
  userRole      UserRole[]
  accounts      UserAccount[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Profile {
  userId    String    @id @map("user_id") @db.Uuid
  phone     String?   @unique @db.VarChar(20)
  birthday  DateTime? @db.Date
  gender    Gender?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserAccount {
  id         BigInt          @id @default(autoincrement()) @db.BigInt
  userId     String          @map("user_id") @db.Uuid
  provider   AccountProvider
  providerId String          @map("provider_id") @db.VarChar(255)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@map("user_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          Int      @id @default(autoincrement()) @db.Integer
  name        RoleName @unique
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  userRole        UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    Int      @map("role_id") @db.Integer
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Category {
  id        Int       @id @default(autoincrement()) @db.Integer
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  parentId  Int?      @map("parent_id") @db.Integer
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  crawledAt DateTime? @map("crawled_at") @db.Timestamptz(6)

  // Relations
  parent          Category?        @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryToCategory")
  crawlConfig     CrawlConfig?
  generalProducts GeneralProduct[]

  @@map("categories")
}

model CrawlConfig {
  id             Int       @id @default(autoincrement()) @db.Integer
  categoryId     Int       @unique @map("category_id") @db.Integer
  cronExpression String    @map("cron_expression") @db.VarChar(100)
  lastCrawledAt  DateTime? @map("last_crawled_at") @db.Timestamptz(6)
  nextCrawlAt    DateTime? @map("next_crawl_at") @db.Timestamptz(6)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("crawl_configs")
}

model GeneralProduct {
  id         Int      @id @default(autoincrement()) @db.Integer
  name       String   @db.VarChar(255)
  slug       String   @unique @db.VarChar(255)
  categoryId Int      @map("category_id") @db.Integer
  imageUrl   String?  @map("image_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([name, categoryId])
  @@map("general_products")
}

model Store {
  id        Int      @id @default(autoincrement()) @db.Integer
  name      String   @unique @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  products Product[]

  @@map("stores")
}

model Product {
  id               Int     @id @default(autoincrement()) @db.Integer
  generalProductId Int     @map("general_product_id") @db.Integer
  name             String  @db.VarChar(255)
  slug             String  @db.VarChar(255)
  originalPrice    Decimal @map("original_price") @db.Decimal(10, 2)
  salePrice        Decimal @map("sale_price") @db.Decimal(10, 2)
  url              String  @db.Text
  urlHash          String  @map("url_hash") @db.Char(64)
  imageUrl         String? @map("image_url") @db.Text
  storeId          Int     @map("store_id") @db.Integer

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  generalProduct GeneralProduct @relation(fields: [generalProductId], references: [id], onDelete: Restrict)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, urlHash])
  @@map("products")
}

model Permission {
  id              String             @id @default(uuid()) @db.Uuid
  action          PermissionAction
  resource        PermissionResource
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Relations
  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       Int      @map("role_id") @db.Integer
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}
